# =============================================================================
# EXEMPLO de configuração de dados de teste
# Copie este arquivo para test-data.properties e preencha os valores reais.
# O arquivo test-data.properties é ignorado pelo Git.
#
# Alternativa: defina variáveis de ambiente (CI/CD) — pontos viram underscores
# em maiúsculas. Ex: test.saucedemo.user.valid → TEST_SAUCEDEMO_USER_VALID
# =============================================================================

# ── Sauce Demo (https://www.saucedemo.com/) — credenciais de teste publicas do proprio site ──
test.saucedemo.user.valid=standard_user
test.saucedemo.user.locked=locked_out_user
test.saucedemo.password.valid=secret_sauce
